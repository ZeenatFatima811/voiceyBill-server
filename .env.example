# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
BASE_PATH=/api

# ─── Exchange Rate ────────
EXCHANGE_RATE_PROVIDER_URL=https://api.frankfurter.dev/v2
EXCHANGE_RATE_TIMEOUT_MS=50000

#exchange rates caches
MAX_CACHE_AGE_MS = 21600000

# ─── Database: Postgres (migration target) ────────────────────────────────────
# Local, via `docker compose up -d postgres`. REQUIRED — there is no default.
DATABASE_URL=postgresql://voiceybill:voiceybill@localhost:5432/voiceybill
#
# Hosted (Neon free tier). IMPORTANT: use the POOLED connection string — the one
# whose host contains "-pooler". The app runs as a Vercel function and scales out
# to many instances; a direct connection string will exhaust the server's
# connection limit under load. See src/db/client.ts.
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require

# Migrations ONLY — the DIRECT endpoint, i.e. the same URL WITHOUT "-pooler".
# DDL must not go through a transaction-mode pooler: statements from one
# migration can land on different backends and drizzle-kit's advisory lock,
# which stops two concurrent deploys applying the same migration, is held per
# connection and would be silently lost. Read by drizzle.config.ts only; the
# running app never needs it, so do NOT set it in Vercel.
# DIRECT_DATABASE_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Use a long random string — e.g. run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_strong_jwt_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_strong_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ─── Google Gemini AI ─────────────────────────────────────────────────────────
# Get your key at https://aistudio.google.com/app/apikey
# Used for: receipt scanning, voice transaction classification
GEMINI_API_KEY=your_gemini_api_key_here

# ─── UpliftAI (Voice Transcription) ───────────────────────────────────────────
# Get your key at https://upliftai.org
# Used for: speech-to-text from voice recordings
UPLIFT_AI_API_KEY=your_upliftai_api_key_here

# ─── Cloudinary (Image Storage) ───────────────────────────────────────────────
# Get your credentials at https://cloudinary.com (free tier available)
# Used for: profile photos, receipt images
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Resend (Email) ───────────────────────────────────────────────────────────
# Get your key at https://resend.com (free tier available)
# Used for: monthly report emails
# Requires a verified domain — leave blank to disable email reports
RESEND_API_KEY=your_resend_api_key_here
RESEND_MAILER_SENDER_REPORTS=reports@voiceybill.com
RESEND_MAILER_SENDER_VERIFY=verify@voiceybill.com



# ─── For Google authentication ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_key_here
GOOGLE_CLIENT_SECRET=your_key_here
GOOGLE_ANDROID_CLIENT_ID=your_key_here
GOOGLE_IOS_CLIENT_ID=your_key_here


# ─── Redis: Upstash ────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=your_actual_upstash_rest_url
UPSTASH_REDIS_REST_TOKEN=your_actual_upstash_token
